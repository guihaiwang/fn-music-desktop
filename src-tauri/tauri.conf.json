{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "feiniu-music-desktop",
  "version": "0.1.0",
  "identifier": "com.foolin.fn-music",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "飞牛音乐",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "Copyright © 2026 foolin",
    "shortDescription": "飞牛音乐",
    "publisher": "foolin",
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {},
    "linux": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}